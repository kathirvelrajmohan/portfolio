---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Kathirvel Rajmohan</div>
    <div class="text-3xl py-3 font-bold">Data Engineer</div>
    <div class="py-2">
      <text class="text-lg">
        Data Engineer with around 2 years of experience writing complex SQL and building PySpark data pipelines
        in Databricks — including cluster configuration, job orchestration, and AWS S3 integration — alongside
        enterprise application development. Databricks Certified Data Engineer Associate, with additional
        hands-on experience in Delta Lake, data quality frameworks, and Medallion architecture through an
        independent end-to-end ETL project.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="mailto:kathirvelrajmohan9498@gmail.com" target="_blank"> Let's connect!</a>
    </div>
  </div>

    <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="mb-10 grid gap-4">
    <div>
      <h3 class="font-semibold mb-1">B.E. in Computer Science and Engineering</h3>
      <span class="font-light text-sm">IFET College of Engineering, Villupuram, Tamil Nadu — Sep 2021 to Apr 2024 — CGPA: 8.4/10</span>
    </div>
    <div>
      <h3 class="font-semibold mb-1">Diploma in Electrical and Electronics Engineering</h3>
      <span class="font-light text-sm">Seshasayee Institute of Technology — July 2018 to Jun 2021 — CGPA: 8.2/10</span>
    </div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href="https://credentials.databricks.com/9b6fb868-bfa2-4047-bd6e-2c9e33150037" target="_blank" class="font-semibold">Databricks Certified Data Engineer Associate</a>
      <span class="font-light text-sm block">2026 — Validates expertise in lakehouse architecture, Delta Lake, ETL pipelines, Apache Spark, and data engineering best practices.</span>
    </li>
  </ul>

  
  <div>
    <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="Sales ETL Pipeline"
    img="/post_img.webp"
    desc="End-to-end data engineering pipeline on Databricks using Medallion Architecture (Bronze/Silver/Gold) on a retail sales dataset. Includes Delta Lake tables with ACID transactions, PySpark transformations, a 53-check automated data quality framework, and a star schema data model."
    url="#"
    badge="ONGOING"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="College Grievance Management System"
    img="/post_img.webp"
    desc="A web-based grievance management system for educational institutions, built with Django, PostgreSQL, HTML/CSS/JS. Lets students, staff, and faculty register and track complaints online with a resolution workflow through the grievance redressal cell."
    url="https://github.com/kathirvelrajmohan/College-Grievance-Management-System"
    badge="FOSS"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>