---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects</div>
  </div>

  <HorizontalCard
    title="Sales ETL Pipeline"
    img="/post_img.webp"
    desc="End-to-end data engineering pipeline on Databricks using Medallion Architecture (Bronze/Silver/Gold) on a retail sales dataset. Implemented Delta Lake tables with ACID transactions and schema evolution, PySpark DataFrame transformations and window functions, and a 53-check automated data quality validation framework with severity-based pipeline gating. Modeled a star schema (fact and dimension tables) and scheduled the pipeline via Databricks Jobs with failure alerting. Currently extending with AWS S3 integration, Docker, CI/CD, and Airflow orchestration."
    url="https://github.com/kathirvelrajmohan/sales-etl-pipeline"
    badge="ONGOING"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="College Grievance Management System"
    img="/post_img.webp"
    desc="A web-based grievance management system for educational institutions built with Django, PostgreSQL, and HTML/CSS/JS. Enables students, staff, and faculty to register and track complaints online, with a resolution workflow through the grievance redressal cell to improve transparency and turnaround."
    url="https://github.com/kathirvelrajmohan/College-Grievance-Management-System"
    badge="FOSS"
  />
</BaseLayout>